# Copiá este archivo a `.env.local` para desarrollo, o cargá las variables en
# Vercel (Settings → Environment Variables) para producción.
# Todas son opcionales: el sitio funciona sin ninguna.

# URL pública del sitio, sin barra final. Si no se define, en Vercel se usa
# el dominio de producción automáticamente y en local http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Google AdSense (dejar vacío hasta tener la cuenta aprobada).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM_BANNER=

# Mostrar recuadros "Publicidad" mientras no haya AdSense (true/false).
NEXT_PUBLIC_ADS_PLACEHOLDER=true

# Código de verificación de Google Search Console (solo el valor del meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
